#!/usr/bin/env bash
# Run a coding shell in a container that sees only the repos listed in repos.conf.
set -euo pipefail

IMAGE=devbox
VOLUME=devbox-home
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CONF="$DIR/repos.conf"

# busy includes a port another box published: docker holds it from container start, idle or not
port_busy() { (: </dev/tcp/127.0.0.1/"$1") 2>/dev/null; }

# "8500" or "5173,5174" -> `ports` (docker -p flags) + `port_list`. Published 1:1, so there is no
# mapping to remember. Checked here only to name the busy port; a dead heat still lands on docker.
add_ports() {
  local p
  local IFS=,
  # shellcheck disable=SC2086  # deliberate: split the comma-separated list
  for p in $1; do
    [[ $p =~ ^[0-9]+$ ]] || {
      echo "devbox: --port: not a port: $p" >&2
      exit 1
    }
    port_busy "$p" && {
      echo "devbox: port $p is already in use on this host -- another box has it?" >&2
      exit 1
    }
    ports+=(-p "127.0.0.1:$p:$p")
    port_list="$port_list $p"
  done
}

# Eats a leading --port flag of "$@", once, either spelling, ports comma-separated:
#   --port 8500                  --port=8500
#   --port 5173,5174,8500        --port=5173,5174,8500
#   --port 5173,8500 -- pnpm -C kaiser2 dev
# Sets `ports`, `port_list`, and `port_args` -- how many arguments the caller must now shift.
parse_ports() {
  ports=()
  port_list=""
  port_args=0
  if [[ ${1-} == --port || ${1-} == --port=* ]]; then
    local val=${1#--port}
    if [[ -z $val ]]; then
      val=${2-}
      port_args=2
    else
      val=${val#=}
      port_args=1
    fi
    # a bare --port would otherwise eat the `--` and publish the command name
    [[ -n $val && $val != -- ]] || {
      echo "devbox: --port needs a value, e.g. --port 5173,8500" >&2
      exit 1
    }
    add_ports "$val"
    shift "$port_args"
    # a bare number here is a second port written the old way, not a command to run inside
    [[ ! ${1-} =~ ^[0-9,]+$ ]] || {
      echo "devbox: list ports with commas: --port $val,$1" >&2
      exit 1
    }
  fi
  # a second flag would otherwise reach docker as part of the command
  [[ ${1-} != --port && ${1-} != --port=* ]] || {
    echo "devbox: --port once only -- list them: --port 5173,8500" >&2
    exit 1
  }
}

case "${1-}" in
  build)
    shift
    exec docker build -t "$IMAGE" "$@" "$DIR"
    ;;
  reset)
    read -r -p "Remove volume $VOLUME (logins, Context7 key, opencode + claude sessions, history)? [y/N] " a
    [[ $a == [yY] ]] || exit 0
    exec docker volume rm "$VOLUME"
    ;;
  update)
    shift
    # git identity, handed over for tool-config to write into the volume's ~/.gitconfig. Only
    # here: an interactive box reads it back from there, so it needs no identity in its env.
    # Empty would reach git as an empty ident and fail at commit time, so catch it now instead.
    git_name="$(git config --global user.name || true)"
    git_email="$(git config --global user.email || true)"
    [[ -n $git_name && -n $git_email ]] || {
      echo "devbox: set git config --global user.name and user.email first (commits inside need them)" >&2
      exit 1
    }
    git_env=(-e GIT_AUTHOR_NAME="$git_name" -e GIT_AUTHOR_EMAIL="$git_email")

    # refresh the volume-side config: agent self-updates, plus the rtk/ctx7 bits that a rebuild
    # cannot reach. The key is read out of the gitignored .env and handed over as an environment
    # variable, never as argv. Parsed rather than sourced: .env is data, not a script to run.
    CONTEXT7_KEY=""
    if [[ -f $DIR/.env ]]; then
      CONTEXT7_KEY="$(sed -n 's/^CONTEXT7_KEY=//p' "$DIR/.env" |
        head -1 | tr -d '\r"'"'"' ')"
      [[ -n $CONTEXT7_KEY ]] || {
        echo "devbox: no CONTEXT7_KEY= in $DIR/.env" >&2
        exit 1
      }
    else
      echo "devbox: no $DIR/.env, configuring Context7 in OAuth mode" >&2
    fi
    export CONTEXT7_KEY
    # shellcheck disable=SC2016  # deliberate: these expand in the container, not here
    set -- bash -lc '
      set -e
      claude update || true
      opencode upgrade || true
      rtk init --global --auto-patch </dev/null
      rtk init --global --opencode --auto-patch </dev/null
      for agent in --claude --opencode; do
        if [ -n "${CONTEXT7_KEY:-}" ]; then
          pnpm dlx ctx7@latest setup "$agent" --mcp --api-key "$CONTEXT7_KEY" -y </dev/null
        else
          pnpm dlx ctx7@latest setup "$agent" --mcp --oauth -y </dev/null
        fi
      done
      tool-config
    '
    ;;
  selftest)
    # faked host, so the check needs neither docker nor a free port
    FAKE_BUSY=""
    port_busy() { [[ " $FAKE_BUSY " == *" $1 "* ]]; }
    fails=0
    expect() { # expect <name> <expected -p flags> <expected shift> <args...>
      local name=$1 exp=$2 shift_exp=$3
      shift 3
      parse_ports "$@" 2>/dev/null
      if [[ "${ports[*]-}" == "$exp" && $port_args == "$shift_exp" ]]; then
        echo "ok: $name"
      else
        echo "FAIL: $name: got '${ports[*]-}' shift $port_args," \
          "want '$exp' shift $shift_exp" >&2
        fails=$((fails + 1))
      fi
    }

    expect "--port=N, published 1:1" "-p 127.0.0.1:8500:8500" 1 --port=8500
    [[ $port_list == " 8500" ]] || {
      echo "FAIL: port_list '$port_list'" >&2
      fails=$((fails + 1))
    }

    # same result either spelling; the space form eats two arguments, not one
    expect "--port N, same result" "-p 127.0.0.1:8500:8500" 2 --port 8500

    expect "comma-separated list" \
      "-p 127.0.0.1:5173:5173 -p 127.0.0.1:5174:5174" 1 --port=5173,5174
    expect "comma-separated, space form" \
      "-p 127.0.0.1:5173:5173 -p 127.0.0.1:5174:5174" 2 --port 5173,5174

    expect "three ports in one list" \
      "-p 127.0.0.1:5173:5173 -p 127.0.0.1:5174:5174 -p 127.0.0.1:8500:8500" \
      2 --port 5173,5174,8500

    # the space-separated spelling is gone: say so instead of running "5174" in the box
    for bad in "--port 5173 5174" "--port=5173 8500"; do
      # shellcheck disable=SC2086  # deliberate: $bad is an argument list
      if (parse_ports $bad) 2>/dev/null; then
        echo "FAIL: '$bad' accepted" >&2
        fails=$((fails + 1))
      else
        echo "ok: space-separated rejected: '$bad'"
      fi
    done

    # the first non-number ends the list, so the command still gets through
    expect "stops at the command" "-p 127.0.0.1:5173:5173" 2 --port 5173 opencode

    # the command behind -- survives untouched
    expect "stops at --" "-p 127.0.0.1:5173:5173" 2 --port 5173 -- bash -lc "echo hi"
    expect "no --port publishes nothing" "" 0 -- bash

    # a port another box holds must fail loudly, not start a half-open box
    FAKE_BUSY="8500"
    if (parse_ports --port 8500) 2>/dev/null; then
      echo "FAIL: busy port accepted" >&2
      fails=$((fails + 1))
    else
      echo "ok: busy port rejected before docker sees it"
    fi

    FAKE_BUSY=""
    if (parse_ports --port=80x) 2>/dev/null; then
      echo "FAIL: non-numeric port accepted" >&2
      fails=$((fails + 1))
    else
      echo "ok: non-numeric port rejected"
    fi

    # a repeated flag must not slip through into the command handed to docker
    for bad in "--port 5173 --port=8500" "--port=5173 --port 8500"; do
      # shellcheck disable=SC2086  # deliberate: $bad is an argument list
      if (parse_ports $bad) 2>/dev/null; then
        echo "FAIL: '$bad' accepted" >&2
        fails=$((fails + 1))
      else
        echo "ok: repeated flag rejected: '$bad'"
      fi
    done

    # a bare --port at the end, or before --, must not swallow what follows
    for bad in "--port" "--port --"; do
      # shellcheck disable=SC2086  # deliberate: $bad is an argument list
      if (parse_ports $bad) 2>/dev/null; then
        echo "FAIL: '--port$bad' accepted without a value" >&2
        fails=$((fails + 1))
      else
        echo "ok: bare '$bad' rejected"
      fi
    done

    [[ $fails == 0 ]] || {
      echo "$fails failed" >&2
      exit 1
    }
    echo "all passed"
    exit 0
    ;;
esac

[[ -f $CONF ]] || {
  echo "devbox: no $CONF (start from repos.conf.example)" >&2
  exit 1
}

mounts=()
names=()
while IFS= read -r line || [[ -n $line ]]; do
  [[ $line == \#* ]] && continue
  line="${line%%[[:space:]]#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -n $line ]] || continue

  path="${line/#\~/$HOME}"
  # resolve, and refuse unknown paths: docker would silently create a root-owned dir on the host
  path="$(cd "$path" 2>/dev/null && pwd -P)" || {
    echo "devbox: not a directory: $line" >&2
    exit 1
  }

  name="$(basename "$path")"
  for seen in ${names[@]+"${names[@]}"}; do
    [[ $seen == "$name" ]] && {
      echo "devbox: two repos named '$name'" >&2
      exit 1
    }
  done
  names+=("$name")
  mounts+=(-v "$path:/code/$name")
done <"$CONF"

((${#mounts[@]})) || {
  echo "devbox: $CONF lists no repos" >&2
  exit 1
}

# AGENTS.md-TEMPLATE, read-only, in both agents' rules directories -- not over their own rule
# files, so the instructions rtk and ctx7 installed at image build keep working alongside it.
# The repo's own AGENTS.md describes this repo and stays outside the box.
RULES="$DIR/AGENTS.md-TEMPLATE"
agents=()
if [[ -f $RULES ]]; then
  agents=(-v "$RULES:/home/t/.config/opencode/rules/agents.md:ro"
    -v "$RULES:/home/t/.claude/rules/agents.md:ro")
fi

# no provider keys from the host env: agents log in inside the box and the credentials stay in
# the home volume. CONTEXT7_KEY is the one exception, and only `devbox update` above sets it --
# it is written into the agents' MCP config, not left in the environment of an interactive run.
keys=()
[[ -n ${CONTEXT7_KEY-} ]] && keys+=(-e CONTEXT7_KEY)

# A box publishes nothing by default, which is what lets several run side by side. On 127.0.0.1
# only, so a dev server is reachable from this host and not from the LAN.
parse_ports "$@"
shift "$port_args"
if [[ ${1-} == -- ]]; then shift; fi

# nothing inside the box knows which of its ports left the container
[[ -z $port_list ]] || echo "devbox: publishing${port_list} on 127.0.0.1" >&2

# The title below holds only while docker starts: the shell inside re-sets it from \u@\h at every
# prompt and wins. Hence "db-8501" -- the port rides along in what that prompt prints.
host_name="db${port_list// /-}"
# not exec'd below, so this shell outlives docker and restores the old title on exit
if [[ -t 1 ]]; then
  printf '\033]0;devbox%s\007' "$port_list"
  trap 'printf "\033]0;\007"' EXIT
fi

# shellcheck disable=SC2046  # deliberate: -t must vanish entirely when stdin is not a tty
docker run --rm -i $([[ -t 0 ]] && echo -t) \
  --init \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --hostname "$host_name" \
  -v "$VOLUME:/home/t" \
  "${mounts[@]}" \
  ${ports[@]+"${ports[@]}"} \
  ${agents[@]+"${agents[@]}"} \
  ${keys[@]+"${keys[@]}"} \
  -w /code \
  -e TERM="${TERM:-xterm-256color}" \
  -e HOST=0.0.0.0 \
  -e STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
  -e STREAMLIT_SERVER_HEADLESS=true \
  ${git_env[@]+"${git_env[@]}"} \
  "$IMAGE" "$@"
